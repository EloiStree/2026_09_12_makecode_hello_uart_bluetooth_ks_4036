UART TO KS4036
https://github.com/EloiStree/2026_09_12_makecode_hello_uart_bluetooth_ks_4036</comment><comment id="d9rVyQMp0YNP{6Df[$h1" x="-4480" y="-3745" w="566" h="438">
# *C128* COMPASS
# *S15* SOUND
# *L0* LIGHT_MICRO_BIT
# *T31* TEMPERATURE
# *AX-16* ACCELEROMETER_X
# *AY1056* ACCELEROMETER_Y
# *AZ-32* ACCELEROMETER_Z
# *AS1056* ACCELEROMETER_STRENGTH
# *ML0* MOTOR_LEFT
# *MR0* MOTOR_RIGHT
# *LRL918* LIGHT_RESISTANCE_LEFT
# *LRR935* LIGHT_RESISTANCE_RIGHT
# *LT0* LINE_TACK_0123
# *TIME490390* TIME
# *US23* ULTRASONIC
# *CLR0G255B255* COLOR_LEFT_RESISTANCE
# *CRR0G255B255* COLOR_RIGHT_RESISTANCE
# *LT1* LINE_TRACK_LEFT
# *RT1* LINE_TRACK_RIGHT

# *EVSHAKE* SHAKED
# *EV3G* 3G FORCE
# *EV6G* 6G FORCE
# *EV8G* 8G FORCE
# *EVTR* TILT RIGHT
# *EVTL* TILT LEFT
# *EVLU* LOGO UP
# *EVLD* LOGO DOWN
# *EVSU* SCREEN UP
# *EVSU* SCREEN DOWN
# *EVFALL* MICRO BIT FALL

# *LOGO* LOGO TRUE
# *logo* LOGO FALSE


# *A* BUTTON A TRUE
# *a* BUTTON A FALSE

# *B* BUTTON B TRUE
# *b* BUTTON B FALSE

# *LOUD* LOUD TRUE
# *quiet* LOUD FALSE

# *EVAB* TRIGGER A+B

